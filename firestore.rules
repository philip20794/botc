rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      // Public game statistics are deliberately readable without an account.
      allow read: if true;

      // Public clients can only add a bounded, schema-shaped immutable record.
      allow create: if validGameRecord(gameId, request.resource.data);
      allow update, delete: if false;
    }
  }

  function validGameRecord(gameId, data) {
    return data is map
      && data.keys().toSet() == [
        'schemaVersion', 'gameId', 'startedAt', 'endedAt', 'totalDurationMs',
        'playerCount', 'winnerTeam', 'script', 'players', 'phases',
        'chronicleEvents'
      ].toSet()
      && data.schemaVersion == 1
      && data.gameId is string
      && data.gameId == gameId
      && data.gameId.size() >= 8 && data.gameId.size() <= 128
      && validTimestampText(data.startedAt)
      && validTimestampText(data.endedAt)
      && data.totalDurationMs is int && data.totalDurationMs > 0
      && data.playerCount is int && data.playerCount >= 1 && data.playerCount <= 20
      && data.winnerTeam in ['good', 'evil']
      && validScript(data.script)
      && validPlayers(data.players, data.playerCount)
      && data.phases is list && data.phases.size() >= 1 && data.phases.size() <= 512
      && data.chronicleEvents is list && data.chronicleEvents.size() <= 4096;
  }

  function validTimestampText(value) {
    // The app validates ISO-8601 syntax and chronological consistency before
    // upload. Rules can enforce the public wire type and a safe bound only.
    return value is string && value.size() >= 20 && value.size() <= 40;
  }

  function validScript(script) {
    return script is map
      && script.keys().toSet() == [
        'scriptId', 'name', 'isCustom', 'roleIds', 'contentHash'
      ].toSet()
      && script.scriptId is string && script.scriptId.size() >= 3
      && script.scriptId.size() <= 128
      && script.name is string && script.name.size() >= 1
      && script.name.size() <= 128
      && script.isCustom is bool
      && script.roleIds is list && script.roleIds.size() >= 1
      && script.roleIds.size() <= 512
      && script.contentHash is string && script.contentHash.size() == 64;
  }

  function validPlayer(player) {
    // Firestore has a strict 1,000-expression budget. The exact field set
    // prevents arbitrary extra keys (e.g. player names or free-form notes)
    // in every player map. The app validates ID formats, field types, teams
    // and positions before upload; those checks cannot all be repeated here
    // for 20 seats without exceeding the server expression budget.
    return player is map
      && player.keys().toSet() == [
        'anonymizedPlayerId', 'position', 'actualStartRoleId',
        'displayedStartRoleId', 'startTeam', 'endRoleId', 'endTeam'
      ].toSet();
  }

  // Evaluate a small group of seats at a time. Long left-associated
  // boolean chains re-evaluate too many expressions in real transactions.
  // This preserves the complete schema validation of all 20 possible seats.
  function validPlayers(players, playerCount) {
    return players is list
      && players.size() == playerCount
      && playerCount >= 1 && playerCount <= 20
      && firstFive(players, playerCount)
      && secondFive(players, playerCount)
      && thirdFive(players, playerCount)
      && fourthFive(players, playerCount);
  }

  function firstFive(players, playerCount) {
    return validPlayer(players[0])
      && (playerCount < 2 || validPlayer(players[1]))
      && (playerCount < 3 || validPlayer(players[2]))
      && (playerCount < 4 || validPlayer(players[3]))
      && (playerCount < 5 || validPlayer(players[4]));
  }

  function secondFive(players, playerCount) {
    return (playerCount < 6 || validPlayer(players[5]))
      && (playerCount < 7 || validPlayer(players[6]))
      && (playerCount < 8 || validPlayer(players[7]))
      && (playerCount < 9 || validPlayer(players[8]))
      && (playerCount < 10 || validPlayer(players[9]));
  }

  function thirdFive(players, playerCount) {
    return (playerCount < 11 || validPlayer(players[10]))
      && (playerCount < 12 || validPlayer(players[11]))
      && (playerCount < 13 || validPlayer(players[12]))
      && (playerCount < 14 || validPlayer(players[13]))
      && (playerCount < 15 || validPlayer(players[14]));
  }

  function fourthFive(players, playerCount) {
    return (playerCount < 16 || validPlayer(players[15]))
      && (playerCount < 17 || validPlayer(players[16]))
      && (playerCount < 18 || validPlayer(players[17]))
      && (playerCount < 19 || validPlayer(players[18]))
      && (playerCount < 20 || validPlayer(players[19]));
  }

}
